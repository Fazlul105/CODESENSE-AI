{
  "name": "codesense-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CodeSense AI - AI-Powered GitHub Code Review & Bug Detection Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@codesense/api",
    "dev:web": "npm run dev --workspace=@codesense/web",
    "build": "npm run build --workspaces",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run test --workspace=@codesense/api",
    "test:web": "npm run test --workspace=@codesense/web"
  },
  "dependencies": {
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
