# ==============================================================================
# CodeSense AI — Environment Configuration Template
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Node.js API Service Port
API_PORT=5001

# Next.js Frontend URL (for CORS and OAuth callbacks)
FRONTEND_URL=http://localhost:3000

# Backend URL (used by clients)
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
# Provide your MongoDB Atlas connection string here:
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/codesense_ai?retryWrites=true&w=majority
# If omitted in development/test, the system will start an in-memory instance for testing.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codesense_ai?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# GitHub Integration & Authentication
# ------------------------------------------------------------------------------
# Optional GitHub Personal Access Token (PAT) to increase rate limits from 60 to 5,000 req/hr
GITHUB_TOKEN=

# GitHub OAuth App Credentials (Required for User Login & Private Repos)
# Register at: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session Secret (used for cookie encryption and session integrity, min 32 chars)
SESSION_SECRET=codesense-ai-super-secret-key-replace-in-production-min-32-chars

# ------------------------------------------------------------------------------
# Generative AI Review Engine (OpenAI or Compatible LLM)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Python ML Defect-Risk Inference Service
# ------------------------------------------------------------------------------
ML_SERVICE_URL=http://127.0.0.1:8000
