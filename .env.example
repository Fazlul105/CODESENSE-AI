# ==============================================================================
# CodeSense AI — Environment Configuration Template
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Node.js API Service Port
API_PORT=5001

# Next.js Frontend URL (for CORS and OAuth redirect callbacks)
# Production example: https://codesense-ai-iota.vercel.app
FRONTEND_URL=http://localhost:3000

# Backend URL (used by Next.js frontend client components)
# Production example: https://codesense-api-fazlul.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MongoDB Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/codesense_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/codesense_ai?retryWrites=true&w=majority

# Allow in-memory DB fallback strictly in local testing (NEVER used in production):
ALLOW_MEMORY_DB=false

# ------------------------------------------------------------------------------
# GitHub Integration & Authentication
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) to increase rate limits from 60 to 5,000 req/hr
GITHUB_TOKEN=

# GitHub OAuth App Credentials (for Developer Login & Private Repos)
# Register at: https://github.com/settings/developers -> New OAuth App
# Production callback: https://codesense-ai-iota.vercel.app/api/auth/callback
# Local callback: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session Secret (cryptographically random secret, min 32 characters)
SESSION_SECRET=codesense-ai-super-secret-key-replace-in-production-min-32-chars

# ------------------------------------------------------------------------------
# Generative AI Review Engine (Google Gemini 3.8 Flash / OpenAI)
# ------------------------------------------------------------------------------
# Active AI provider: 'gemini' (Recommended) or 'openai'
AI_PROVIDER=gemini

# Google Gemini API Credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI API Credentials (Optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Python ML Defect-Risk Inference Service
# ------------------------------------------------------------------------------
# Microservice URL for scikit-learn Kamei JIT defect prediction model
ML_SERVICE_URL=http://127.0.0.1:8000
